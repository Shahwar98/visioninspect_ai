# Copy this file to .env and fill in the keys you have.
# The app works with NONE of these set - it will automatically fall back
# to the classical computer-vision detector and the rule-based report.

# --- Roboflow (hosted Pothole / Alligator Cracking / Lateral Cracking workflow) ---
# Get a free key at https://app.roboflow.com/settings/api (use the Private key)
ROBOFLOW_API_KEY=
# Optional overrides - defaults to the workflow validated in Roboflow's UI
ROBOFLOW_WORKSPACE_NAME=shahwar
ROBOFLOW_WORKFLOW_ID=general-segmentation-api
# Comma-separated list of classes to detect - required by this workflow's
# SAM step, leave blank to use all three defaults (Pothole, Alligator
# Cracking, Lateral Cracking)
ROBOFLOW_CLASSES=

# --- Local YOLO weights (optional, fully offline) ---
# Path to a .pt file trained for crack/corrosion/defect detection, if you have one
YOLO_WEIGHTS_PATH=

# --- Anthropic (optional LLM-enhanced report narrative) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
